# Copy to .env. Every stage that calls a model reads these; the download and
# packaging stages do not need them.
#
#   paraphrase_corpus.py   rewrites the corpus
#   generate_questions.py  mines questions from articles
#   answer_questions.py    answers them through wookiee_chat.py
#   wookiee_chat.py        the interactive chatbot

DEEPSEEK_API_KEY=

# Optional. Any OpenAI-compatible endpoint works -- point this at a local
# server or another provider and the pipeline follows.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional, and only for `uv run scripts/upload_hf.py --push`. `hf auth login` works too.
# HF_TOKEN=
